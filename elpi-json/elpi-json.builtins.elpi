% Yojson.Basic.t
data json.
symb json.null   : json.  % Null
symb json.bool   : bool -> json.  % Bool
symb json.int    : int -> json.  % Int
symb json.float  : float -> json.  % Float
symb json.string : string -> json.  % String
symb json.assoc  : list (pair string json) -> json.  % key value pairs. When generated from built-in predicates, keys are sorted
symb json.list   : list json -> json.  % List

func json.copy json -> json.
json.copy json.null json.null.
json.copy (json.bool A0) (json.bool B0) :- (bool.copy A0 B0).
json.copy (json.int A0) (json.int B0) :- (int.copy A0 B0).
json.copy (json.float A0) (json.float B0) :- (float.copy A0 B0).
json.copy (json.string A0) (json.string B0) :- (string.copy A0 B0).
json.copy (json.assoc A0) (json.assoc B0) :- ((list.copy (pair.copy string.copy json.copy)) A0 B0).
json.copy (json.list A0) (json.list B0) :- ((list.copy json.copy) A0 B0).



% [json.from_file File J D] like Yojson.Basic.from_file reads J from File.
% If D is error then J is not assigned.
builtin func json.from_file string -> json, diagnostic.

% [json.from_string String J D] like Yojson.Basic.from_string reads J from
% String.
% If D is error then J is not assigned.
builtin func json.from_string string -> json, diagnostic.

% [json.to_file File J D] like Yojson.Basic.to_file writes J to File.
builtin func json.to_file string, json -> diagnostic.

% [json.to_string J S D] like Yojson.Basic.to_string writes J to a compact
% string S.
builtin func json.to_string json -> string, diagnostic.

% [json.pretty_to_string J S D] like Yojson.Basic.pretty_to_string writes J
% to a nice string S.
builtin func json.pretty_to_string json -> string, diagnostic.




