

% context items for term A B (Entry)
builtin func entry (term A B) -> string.


builtin data term A B.
builtin symb const : A -> term A B = "0".  % Const
builtin symb tag   : B -> term A B -> term A B = "0".  % Tag
builtin symb lam   : string -> (term A B -> term A B) -> term A B = "0".  % Lam

func term.copy (func X0 -> Y0), (func X1 -> Y1), term X0 X1 -> term Y0 Y1.
term.copy F0 _ (const A0) (const B0) :- (F0 A0 B0).
term.copy F0 F1 (tag A0 A1) (tag B0 B1) :- (F1 A0 B0), ((term.copy F0 F1) A1 B1).
term.copy F0 F1 (lam A0 A1) (lam B0 B1) :- (string.copy A0 B0), (pi x\ pi y\ entry x B0 ==> entry y B0 ==> (term.copy F0 F1 x y :- !) ==> ((term.copy F0 F1) (A1 x) (B1 y))).








func inc int -> int.
inc X Y :- Y is X + 1.

main :-
  term.copy inc string.copy
    (lam "x" x\ tag "t" (lam "y" y\ const 1)) T,
  T = lam "x" x\ tag "t" (lam "y" y\ const 2).

