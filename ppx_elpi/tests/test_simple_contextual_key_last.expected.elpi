

% context items for term (Entry)
builtin func entry term -> bool, string.


builtin data term.
builtin symb app : term -> term -> term = "0".  % App
builtin symb lam : bool -> string -> (term -> term) -> term = "0".  % Lam

func term.copy term -> term.
term.copy (app A0 A1) (app B0 B1) :- (term.copy A0 B0), (term.copy A1 B1).
term.copy (lam A0 A1 A2) (lam B0 B1 B2) :- (bool.copy A0 B0), (string.copy A1 B1), (pi x\ entry x B0 B1 ==> term.copy x x ==> (term.copy (A2 x) (B2 x))).



% [term->string T S] what else
builtin func term->string term -> string.




