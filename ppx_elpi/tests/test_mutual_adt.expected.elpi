

data simple.
symb a : simple.  % A
symb b : int -> mut -> simple.  % B

func simple.copy simple -> simple.
simple.copy a a.
simple.copy (b A0 A1) (b B0 B1) :- (int.copy A0 B0), (mut.copy A1 B1).



data mut.
symb c : mut.  % C
symb d : simple -> mut.  % D

func mut.copy mut -> mut.
mut.copy c c.
mut.copy (d A0) (d B0) :- (simple.copy A0 B0).








main :-
  simple.copy (b 1 (d (b 2 c))) X,
  X = b 1 (d (b 2 c)),
  mut.copy (d a) Y, Y = d a.

/* OUTPUT
*/
