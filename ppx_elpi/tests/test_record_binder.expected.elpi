

% context items for term (Entry)
builtin func entry term -> string.


builtin data term.
builtin symb app : term -> term -> term = "0".  % App
builtin symb lam : string -> (term -> term) -> term = "0".  % Lam

func term.copy term -> term.
term.copy (app A0 A1) (app B0 B1) :- (term.copy A0 B0), (term.copy A1 B1).
term.copy (lam A0 A1) (lam B0 B1) :- (string.copy A0 B0), (pi x\ entry x B0 ==> term.copy x x ==> (term.copy (A1 x) (B1 x))).








main :-
  term.copy (lam "x" x\ app x x) Y,
  Y = lam "x" y\ app y y.

/* OUTPUT
*/
