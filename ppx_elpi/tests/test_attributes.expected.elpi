

% The colours
data color.
symb red   : color.  % Red
symb green : color.  % Green
symb blue  : int -> color.  % Blue

func color.copy color -> color.
color.copy red red.
color.copy green green.
color.copy (blue A0) (blue B0) :- (int.copy A0 B0).



data shape.
symb round  : int -> shape.  % A circle
symb square : int -> shape.  % Square

func shape.copy shape -> shape.
shape.copy (round A0) (round B0) :- (int.copy A0 B0).
shape.copy (square A0) (square B0) :- (int.copy A0 B0).



data nest.
symb n : option (list shape) -> pair int (list color) -> nest.  % N

func nest.copy nest -> nest.
nest.copy (n A0 A1) (n B0 B1) :- ((option.copy (list.copy shape.copy)) A0 B0), ((pair.copy int.copy (list.copy color.copy)) A1 B1).








main :-
  color.copy (blue 3) (blue 3),
  shape.copy (round 1) (round 1),
  nest.copy (n (some [square 1]) (pr 1 [red, green])) X,
  X = n (some [square 1]) (pr 1 [red, green]).

/* OUTPUT
*/
