

data simple.
symb k1 : int -> bool -> simple.  % K1
symb k2 : bool -> simple.  % K2

func simple.copy simple -> simple.
simple.copy (k1 A0 A1) (k1 B0 B1) :- (int.copy A0 B0), (bool.copy A1 B1).
simple.copy (k2 A0) (k2 B0) :- (bool.copy A0 B0).








main :-
  simple.copy (k1 1 tt) X, X = k1 1 tt,
  simple.copy (k2 ff) Y, Y = k2 ff.

/* OUTPUT
*/
