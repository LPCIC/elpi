

% context items for term (Entry)
builtin func entry term -> string, bool.


builtin data term.
builtin symb app : term -> term -> term = "0".  % App
builtin symb lam : bool -> string -> (term -> term) -> term = "0".  % Lam

func term.copy term -> term.
term.copy (app A0 A1) (app B0 B1) :- (term.copy A0 B0), (term.copy A1 B1).
term.copy (lam A0 A1 A2) (lam B0 B1 B2) :- (bool.copy A0 B0), (string.copy A1 B1), (pi x\ entry x B1 B0 ==> term.copy x x ==> (term.copy (A2 x) (B2 x))).



% The colours
builtin data color.
builtin symb red   : color = "1". 
builtin symb green : color = "1". 
builtin symb blue  : int -> color = "1". 

% [describe T C S] describes a term and a colour
builtin func describe term, color -> string.






main :-
  pi x\
    entry x "x" tt ==>
      print {describe (lam tt "y" y\ app x y) (blue 3)}.

