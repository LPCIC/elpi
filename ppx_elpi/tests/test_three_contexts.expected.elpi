

% context items for t1 (E1)
builtin func e1 t1 -> string, int.


builtin data t1.
builtin symb a1 : t1 -> t1 -> t1 = "0".  % A1
builtin symb k  : int -> t1 = "1".  % K1
builtin symb l1 : int -> string -> (t1 -> t1) -> t1 = "0".  % L1

func t1.copy t1 -> t1.
t1.copy (a1 A0 A1) (a1 B0 B1) :- (t1.copy A0 B0), (t1.copy A1 B1).
t1.copy (k A0) (k B0) :- (int.copy A0 B0).
t1.copy (l1 A0 A1 A2) (l1 B0 B1 B2) :- (int.copy A0 B0), (string.copy A1 B1), (pi x\ e1 x B1 B0 ==> t1.copy x x ==> (t1.copy (A2 x) (B2 x))).



% context items for t2 (E2)
builtin func e2 t2 -> string, int.


builtin data t2.
builtin symb a2 : t2 -> t2 -> t2 = "0".  % A2
builtin symb k  : int -> t2 = "2".  % K2
builtin symb l2 : int -> string -> (t2 -> t2) -> t2 = "0".  % L2

func t2.copy t2 -> t2.
t2.copy (a2 A0 A1) (a2 B0 B1) :- (t2.copy A0 B0), (t2.copy A1 B1).
t2.copy (k A0) (k B0) :- (int.copy A0 B0).
t2.copy (l2 A0 A1 A2) (l2 B0 B1 B2) :- (int.copy A0 B0), (string.copy A1 B1), (pi x\ e2 x B1 B0 ==> t2.copy x x ==> (t2.copy (A2 x) (B2 x))).



% context items for t3 (E3)
builtin func e3 t3 -> string, int.


builtin data t3.
builtin symb a3 : t3 -> t3 -> t3 = "0".  % A3
builtin symb k  : int -> t3 = "3".  % K3
builtin symb l3 : int -> string -> (t3 -> t3) -> t3 = "0".  % L3

func t3.copy t3 -> t3.
t3.copy (a3 A0 A1) (a3 B0 B1) :- (t3.copy A0 B0), (t3.copy A1 B1).
t3.copy (k A0) (k B0) :- (int.copy A0 B0).
t3.copy (l3 A0 A1 A2) (l3 B0 B1 B2) :- (int.copy A0 B0), (string.copy A1 B1), (pi x\ e3 x B1 B0 ==> t3.copy x x ==> (t3.copy (A2 x) (B2 x))).



% [all->string A B C S] three data types, each one under its own context
builtin func all->string t1, t2, t3 -> string.






main :-
  pi x y z\
    e1 x "x" 1 ==> e2 y "y" 2 ==> e3 z "z" 3 ==>
    t1.copy x x ==> t2.copy y y ==> t3.copy z z ==> (
      sigma A B C D E F K1 K2 K3\
        A = (a1 x x),
        B = (l2 2 "w" w\ a2 w y),
        C = (a3 z z),
        print {all->string A B C},
        t1.copy A D, t2.copy B E, t3.copy C F,
        print {all->string D E F},
        % k is the constructor of three types, the type tells which one is meant
        t1.copy (k 1) K1, t2.copy (k 2) K2, t3.copy (k 3) K3,
        K1 = k 1, K2 = k 2, K3 = k 3).

