

data color.
symb red   : color.  % Red
symb green : color.  % Green
symb blue  : int -> color.  % Blue

func color.copy color -> color.
color.copy red red.
color.copy green green.
color.copy (blue A0) (blue B0) :- (int.copy A0 B0).



data lam.
symb ap : lam -> lam -> lam.
symb lm : string -> (lam -> lam) -> lam.


func known lam -> string.

% [describe T C S R] describes a term and a colour, and applies the term to
% y
builtin func describe lam, color -> string, lam.






main :-
  pi a b\
    known a "x" ==> known b "y" ==>
      sigma S R\
        describe (lm "z" z\ ap z (ap a b)) (blue 3) S R,
        print S,
        % the name y is mapped back to the constant b by the context
        print R.

