% The indexing with trie is used and returns no clauses
:index (1 1)
pred p int -> int.

pred build_p int, int, int -> list (pred).
build_p _ 0 0 [p 0 0] :- !.
build_p Mem X 0 [p X 0 | TL] :-
  X > 0, X' is X - 1,
  build_p Mem X' Mem TL.
build_p Mem X Y [p X Y | TL] :-
  Y > 0, Y' is Y - 1,
  build_p Mem X Y' TL.

pred ground -> A.
% :untyped
ground X.

main :-
  N = 100,
  build_p N N N L,
  ground X,
  L => std.time (p X 0) T, 
  print T.