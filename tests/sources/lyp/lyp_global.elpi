% The Formal System λΥP: signature validation

% Syntax %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% annotation: R
data ann.

% signature: G
data genv.

% empty signature
symb g_top genv.

% referred declaration
symb g_dec id -> genv -> genv.

% referred definition
symb g_def id -> genv -> genv.

% specification for referred declaration
pred type_g -> id, ann, deg, term.

% specification for referred definition
pred cast_g -> id, ann, deg, term, term.

% Signature Validity %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

pred valid_g -> genv.

valid_g g_top.

valid_g (g_dec X G) :-
  type_g X R D U, %, print R X,
  dec_t D U, dec_l X D U => valid_g G.

valid_g (g_def X G) :-
  cast_g X R D U T, %, print R X,
  def_t D U T, dec_l X D U => def_l X T => valid_g G.
