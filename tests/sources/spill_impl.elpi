data term.
symb app term -> term -> term.
symb lam (term -> term) -> term.
symb t term.

pred copy term -> term.
copy (app A B) (app A1 B1) :- copy A A1, copy B B1.
copy (lam F) (lam F1) :- pi x\ copy (F x) (F1 x).
% we omit (copy x x) on purpose

main :-
  T = (lam x\ {copy x t => copy (app x x)}),
  print T,
  T = (lam _\ app t t). 
