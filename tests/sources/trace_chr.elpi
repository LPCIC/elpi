constraint even odd {
  rule \ (even X) (odd X) | (odd z) <=> true.
  rule \ (even X) (odd X) | (odd (s z)) <=> fail.
}
data nat.
symb s nat -> nat.
symb z nat.

func even nat.
func odd nat.
even z.

odd (s X) :- even X.
even (s X) :- odd X.

even (uvar as X) :- declare_constraint (even X) X.
odd (uvar as X) :- declare_constraint (odd X) X.

main :-
  even Z,
  declare_constraint true Z,
  Z = s W,
  not(even W).

