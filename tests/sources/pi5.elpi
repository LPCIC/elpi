% q X, r X, s X all yields X=ok
data i.
symb lam, bam (i -> i) -> i.
pred of -> i.
symb stop i.
pred s -> diagnostic.
pred r -> diagnostic.
pred q -> diagnostic.

of stop.
of (bam x\x).
of (lam x\F) :- pi w\ of F.

q X :- of (lam x\ bam y\ y), X = ok.
r X :- of (bam y\ y), X = ok.
s X :- of (lam x\ lam y\ stop), X = ok.

main :- q X, r S, s T, X = ok, S = ok, T = ok.
