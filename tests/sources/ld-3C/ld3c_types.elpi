% Engine for \lambda\delta version 3C - types

% label of global constant: L
data label.

% sort index: S
data universe.

% abstraction layer: E
data layer.

% closed term: T, U, V, W
data term.

% term body: B
macro @body :- term -> term.

% application arguments: Vs, Ws 
macro @args :- list term.

% sort S: sort of index S
symb sort universe -> term.
% abbr V B: abbreviation of V in B
symb abbr term -> @body -> term.
% abst E W B: abstraction of type W in B
symb abst layer -> term -> @body -> term.
% appl V T: application of T to V
symb appl term -> term -> term.
% cast U T: annotation with type U of T
symb cast term -> term -> term.
% impl: implicit (to be inferred)
symb impl term.

% rt-reduction side: D
data side.

% context side
symb d_rc side.

% inferred side
symb d_sn side.

% expected side
symb d_dx side.

% ldef X V: local definition of X with V
pred ldef -> term, side, term.
% ldec X W: local declaration of X of type W
pred ldec -> term, side, term.

% whd mode: M
data whm.

% no \upsilon-reduction detected (full mode)
symb m_f whm.

% \upsilon-reduction detected (restricted mode)
symb m_y whm.

% PARAMETER: no \Pi-reuctions needed
pred no_pir.

% PARAMETER: successive sort
pred succ -> universe, universe.

% PARAMETER: layer has beta-reduction
pred has_beta -> layer.

% PARAMETER: layer has upsilon-reduction
pred has_upsilon -> layer.

% PARAMETER: preceding layer
pred prec -> layer, layer.

% predicates

pred valid_c -> term, @args, term, @args.
pred valid_t -> term, term.
pred valid_v -> @args, @args.

pred sta_t -> term, side, term.

pred appl_c -> term, @args, @args, side.
pred appl_t -> @args, term.

pred conv_c -> term, @args, whm, term, @args, whm.
pred conv_d -> term, term, @args, whm, term, @args, whm.
pred conv_t -> term, term.
pred conv_v -> @args, @args.

pred cast_t -> term, term.
