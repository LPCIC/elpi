% [double X Y] holds when Y is twice X.
func double int -> int.
double X Y :- Y is X * 2.

kind color type.
symb red, green : color.

typeabbrev ints (list int).

macro @twice X :- (X, X).

namespace foo {
  pred bar int -> int.
  bar X X.
  namespace baz {
    pred qux.
    qux.
  }
  pred use.
  use :- bar 1 _, baz.qux, foo.bar 2 _.
}

namespace foo {
  pred other.
  other :- foo.bar 3 _.
}

shorten std.{ map }.

pred colors list color.
colors L :- map [1] (x\y\ y = red) L, std.map [] (x\y\ true) _, double 1 _, @twice true.
