; the common code
(library
 (name test_lsp_lib)
 (optional)
 (modules test_lsp_lib)
 (libraries yojson unix str threads.posix))

; the scripts, one per .elpi file, that register themselves
(library
 (name test_lsp_scripts)
 (optional)
 (modules :standard \ test_lsp_lib test_lsp)
 (libraries test_lsp_lib))

(executable
 (name test_lsp)
 (optional)
 (modules test_lsp)
 (link_flags (-linkall)) ; to link the scripts
 (libraries test_lsp_lib test_lsp_scripts))
; The output of the script NAME is written to NAME.output by the test and
; compared with NAME.expected; test_lsp.output has the rest. Add NAME to the
; targets and a diff for each new script.
(rule
 (targets test_lsp.output accbad.output accmissing.output good.output
          syntax.output typeerr.output warn.output binders.output library.output macros.output libdef.output doc.output acctype.output lists.output accchar.output run.output
          assemble.output anomaly.output accinc.output accopen.output accdirs.output stubs.output pkgs.output proj.output projtoml.output badproj.output quoteproj.output spill.output macrobind.output warnproj.output projprefix.output tomledit.output accwarn.output)
 (deps (glob_files *.elpi) (glob_files include/*.elpi) (glob_files pkgs/elpi-test-lsp/*) (glob_files accdirs/lang/*.elpi) (glob_files accdirs/a/*.elpi)
       (glob_files accdirs/b/*.elpi) (glob_files accdirs/main/*.elpi)
       proj/elpi.toml (glob_files proj/*.elpi) (glob_files proj/src/*.elpi) (glob_files proj/lib/*.elpi)
       (glob_files proj/inc/*.elpi) badproj/elpi.toml badproj/main.elpi
       quoteproj/elpi.toml (glob_files quoteproj/*.elpi) warnproj/elpi.toml warnproj/main.elpi (alias_rec ../../tests/plugin/ocamlpath/all))
 (action
  (with-stdout-to test_lsp.output
   (setenv OCAMLPATH %{read:ocamlpath.txt}
    (run %{exe:test_lsp.exe} %{exe:../stdio_lsp_driver.exe} . -I include)))))

; the OCAMLPATH of the tests: its directories are separated by ; on Windows
(rule
 (target ocamlpath.txt)
 (enabled_if (= %{os_type} Win32))
 (action (with-stdout-to %{target} (echo "pkgs;../../tests/plugin/ocamlpath"))))

(rule
 (target ocamlpath.txt)
 (enabled_if (<> %{os_type} Win32))
 (action (with-stdout-to %{target} (echo "pkgs:../../tests/plugin/ocamlpath"))))

(rule
 (alias runtest-lsp)
 (action (diff test_lsp.expected test_lsp.output)))

