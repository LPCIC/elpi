% [twice X Y] holds when Y is twice X.
% It is a function.
func twice int -> int.
twice X Y :- Y is X * 2.

% not the documentation of undocumented: a blank line follows

pred undocumented -> int.
undocumented 1.

/* the entry point,
   a multiline comment */
pred main.

main :- twice 21 A, print A, undocumented _.
main :- print "a long body",
  print "line 2", print "line 3",
  print "line 4", print "line 5",
  print "line 6", print "line 7",
  print "line 8",
  print "line 9: not previewed".

% doc of pa
pred pa.
pa :- true. % after code: not documentation
pred qa.
pred pg. % about pg, not the documentation of ph
pred ph.
% doc of pb
pred pb % inside the declaration
  int.
pred uses.
uses :- pa, qa, ph, pb 1.

% a comment after the full stop documents a declaration with no comment before
kind color type.
symb red : color. % the color of fire
symb green, blue : color. % two colors
symb gray : color. /* a block comment: not documentation */
symb a : color. symb b : color. % documents b, not a
pred pc
  color. % after a multi-line signature
% above pd
pred pd. % not shown: the comment before wins
pred uses2.
uses2 :- pg, pc red, pd, print green blue gray a b ok.
