(* Checking a document with Elpi: error-resilient parsing first (a
   declaration with a syntax error is skipped, see API.Parse.program_from),
   then compilation (scoping and type checking) as a unit through the API of
   the program without the erroneous declarations, so that type errors, hover
   and definition are available even when the text has syntax errors. The
   result is a list of diagnostics, as byte offsets in the text, and, when the
   program compiles, the information for the requests on the symbols (hover,
   definition, highlights, semantic tokens). *)

open Elpi.API

(** {2 Setup} *)

(** prints on stderr, prefixed by [[elpi-lsp]] *)
val log : ('a, unit, string, unit) format4 -> 'a

(** An instance of Elpi, for a document: each document has its own, since
    the builtins can differ. It has its own cache of compiled units (see
    [check]), freed with it. *)
type instance

(** a new instance, with the standard builtins; accumulated files are
    resolved relative to the accumulating file *)
val new_instance : unit -> instance

val elpi : instance -> Setup.elpi

(** a number that names the instance, different for each instance *)
val id : instance -> int

(** the maximum number of errors reported for a file (default 100) *)
val max_errors : int ref

(** the trace level asked by the client: [Messages] logs the time of the
    phases of a check, [Verbose] also the units of the program (as the
    environment variable ELPI_LSP_PROFILE does for the time) *)
val set_trace : Lsp.Types.TraceValues.t -> unit

(** An error of Elpi (or any exception), as a location and a message *)
val error_of_exn : exn -> Ast.Loc.t option * string

(** {2 The standard library}

    The files of the library are read, but the text of the file
    "builtin.elpi" is generated by Elpi (the declarations of the builtins
    written in OCaml, and the code of the library). It is the text that the
    compiler parsed, so the locations of the symbols of the library are in it.
    The #line directives split it in files (builtin_stdlib.elpi, ...), as the
    locations see them. Each driver shows these files to the editor in its
    own way (written on the disk, or served by the server). *)

(** the files of the library of an instance (they depend on its builtins), by
    name, computed the first time *)
val library_files : instance -> (string, string) Hashtbl.t

(** the text of the file of the library [name] (eg builtin_stdlib.elpi) of an
    instance *)
val library_text : instance -> string -> string option

(** whether a path is a file of the library opened by the editor: it is not
    meant to be edited, nor checked for determinacy. Set by the driver. *)
val is_library_path : (string -> bool) ref

(** {2 Checking} *)

type severity = Error | Warning | Information

type diagnostic = {
  start : int;   (** byte offsets in the document *)
  stop : int;
  severity : severity;
  message : string;
}

(** the information on the symbols of a checked document, for the requests
    below; computed when needed *)
type hover

type result = {
  diagnostics : diagnostic list;
  hover : hover option; (** unless the parser failed (the text can have errors) *)
}

(** [check ~instance ~path text] checks the document [path] whose contents is
    [text] with [instance]. The units of the program (the accumulated files,
    then the document) are cached: with the same instance, an accumulated file
    is compiled once, not at each check. *)
val check : instance:instance -> path:string -> string -> result

(** {2 Requests}

    The requests take a byte offset in the document [path] (the cursor) and
    the result of its check. *)

(** what is shown on hover *)
type hover_text = {
  range : Ast.Loc.t;       (** what the text is about, highlighted by the client *)
  term : string option;    (** the text of [range], for a term *)
  type_ : string;          (** the type of a term, what a type expression says *)
  binder : string option;  (** for a variable, where it is bound *)
  doc : Ast.Loc.t option;  (** for a constant, the comment block before its declaration *)
}

(** the type of the innermost term (or type expression) at the cursor *)
val hover_at : path:string -> text:string -> int -> hover -> hover_text option

(** [doc_text text loc] is the comment block at [loc] in [text], without the
    comment markers *)
val doc_text : string -> Ast.Loc.t -> string

(** the symbol at the cursor and its definition: the declaration of a
    constant (and its body, see LSP.info), the binder of a variable (the head
    of the rule for a variable of the rule) *)
val definition_at : path:string -> int -> hover -> (Ast.Loc.t * Ast.Loc.t * Ast.Loc.t option) option

(** [complete_binder text l] is the binder [l] of a variable with the
    backslash that follows it in [text] *)
val complete_binder : string -> Ast.Loc.t -> Ast.Loc.t

type highlight =
  | Binder_of_variable of Ast.Loc.t      (** the binder, or the head of the rule *)
  | Definition_of_constant of Ast.Loc.t  (** the declaration, when it is in the document *)
  | Occurrence of Ast.Loc.t

(** the occurrences in the document of the variable or constant at the
    cursor, and its binder or declaration *)
val highlights_at : path:string -> int -> hover -> highlight list

(** the legend of the semantic tokens: the names of their types and
    modifiers *)
val token_types : string list
val token_modifiers : string list

(** The semantic tokens of the document, as the data of the protocol: for
    each one, the line and the column (UTF-16 units) relative to the previous
    one, the length, the type and the modifiers. Tokens that overlap or span
    lines are dropped. *)
val semantic_tokens : path:string -> Text.t -> hover -> int array
