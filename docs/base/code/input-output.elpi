% An input argument is matched: passing an unassigned variable matches no
% rule, since matching a variable against a rule's pattern would have to
% assign it. An output argument is unified: it does get assigned.

data tm.
symb z tm.
symb s tm -> tm.

pred as-input i:tm.
as-input z :- print "matched z".
as-input (s _) :- print "matched s _".

pred as-output o:tm.
as-output z.

main :-
  (pi x\ sigma X\ (as-input X ; print "as-input X: no rule matched an unassigned X")),
  sigma Y\ (as-output Y, print "as-output assigned Y to" Y).
