% Recursing under a binder (depth), and introspecting the eigenvariables
% currently in scope (names / occurs / closed_term).

data tm.
symb app tm -> tm -> tm.
symb lam (tm -> tm) -> tm.

pred depth i:tm, o:int.
depth (app H A) N :- !, depth H N1, depth A N2, N is {std.max N1 N2}.
depth (lam F) N :- !, pi x\ depth (F x) N1, N is N1 + 1.
depth _ 0.

main :-
  depth (lam x\ lam y\ app x y) D, print "depth:" D,
  pi x\ pi y\ sigma Ns\ sigma Len\ sigma T\
    ( names Ns, std.length Ns Len,
      print "eigenvariables in scope:" Len,
      (occurs x (app x y), print "x occurs in (app x y): yes" ; print "no"),
      closed_term T, print "closed_term succeeded" ).
