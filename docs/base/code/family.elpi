% Example used in the "The logic programming model" chapter.

kind person  type.
type mallory, bob, alice  person.

pred age -> person, int.
age mallory 23.
age bob 23.
age alice 20.

pred older person -> person.
older P Q :- age P N, age Q M, N > M.

main :- older bob X, print "bob is older than" X.
