% Type declarations: a data type, its data constructors, a type abbreviation,
% and predicate signatures written over them.

data tree A.                         % a parametric data type

symb leaf tree A.                    % data constructors
symb node A -> tree A -> tree A -> tree A.

typeabbrev names (list string).      % an abbreviation

func size tree A -> int.             % a deterministic signature: one answer
size leaf 0.
size (node _ L R) N :- size L NL, size R NR, N is 1 + NL + NR.

pred has-label tree A, A.            % a relational signature: the label may be
has-label (node X _ _) X.            % at this node,
has-label (node _ L _) X :- has-label L X.   % or somewhere on the left,
has-label (node _ _ R) X :- has-label R X.   % or somewhere on the right

main :-
  T = node "a" (node "b" leaf leaf) (node "a" leaf leaf),
  size T N,
  has-label T "a",
  print "size is" N "and a is a label".
