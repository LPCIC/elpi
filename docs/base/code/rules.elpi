% Rules and queries — a small sample.

kind person  type.
type alice, bob, carol  person.

pred parent -> person, person.        % three facts
parent alice bob.
parent bob carol.

pred ancestor -> person, person.      % a rule with two clauses
ancestor X Y :- parent X Y.
ancestor X Y :- parent X Z, ancestor Z Y.

main :-
  std.findall (ancestor alice _) All,   % the query: every Y with `ancestor alice Y`
  std.length All N,
  print "alice has" N "descendants".
