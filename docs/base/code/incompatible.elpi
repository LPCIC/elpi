% `of (app D D) T` applies an unknown D to itself. The checker suspends two
% goals about D — "D : X1" and "D : arr X1 X2" — which cannot both hold. The
% one-line constraint rule below (explained in "The constraint store")
% combines them into X1 = arr X1 X2, which fails the occur check, so the
% term is rejected, as it should be.

data tm.
data ty.
symb app tm -> tm -> tm.
symb lam (tm -> tm) -> tm.
symb arr ty -> ty -> ty.

func of tm -> ty.
of (app H A) T :- of H (arr S T), of A S.
of (lam F) (arr S T) :- pi c\ of c S ==> of (F c) T.
of (uvar as E) T :- declare_constraint (of E T) [E].

constraint of {
  rule (of X S1) \ (of X S2) <=> (S1 = S2).
}

main :-
  ( of (app D D) _T, print "of (app D D): typed"
  ; print "of (app D D): rejected" ).
