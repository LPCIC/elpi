% Unification (=) performs the occur check by default; a predicate marked
% :nooc, like the builtin unsound_unif, does not.

kind tm type.
symbol f : tm -> tm.

main :-
  (pi x\ sigma X\ (X = f X, print "should not happen")
   ; print "= rejects X = f X (occur check)"),
  (pi x\ sigma Y\ (unsound_unif Y (f Y), print "unsound_unif Y (f Y) succeeds")
   ; print "should not happen").
