(executable
  (name elpi_REPL)
  (public_name elpi)
  (libraries elpi elpi.parser ;memtrace
  )
  (modules elpi_REPL)
  (package elpi))

(executable
  (name elpi_inspect_unit)
  (libraries elpi
  )
  (modules elpi_inspect_unit)
)
(env
  (dev
    (flags (:standard -w -9 -w -27 -warn-error -A))))

; like @all, but without ppx_elpi (see make build-ppx) and elpi-lsp (see make
; build-lsp), that have additional dependencies
(alias
 (name only-elpi)
 (deps (package elpi) (alias_rec src/all) (alias_rec tests/all) (alias_rec trace/all)
       elpi_REPL.exe elpi_inspect_unit.exe))
