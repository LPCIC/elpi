;; The tests of lsp/test (make test-webrunner) on the web build of the
;; server, run by bridge.mjs, one directory each:
;;
;; - node-js, node-wasm: the server compiled to JavaScript, to WebAssembly, run
;;   as in Node (node-worker.cjs), where accumulate reads the files;
;; - browser-SCENARIO: the entry point elpi-lsp-web.js, run in an emulated
;;   browser (../browser.cjs) in SCENARIO, where it picks the server; what it
;;   loads (loaded.log) is compared with loaded-SCENARIO.expected. In a browser
;;   there are no files, accumulate fails: the scripts that accumulate files
;;   are not run.
;;
;; The outputs are compared (compare.cjs) with the ones of the native server,
;; but the ones that differ, whose expected outputs are here: the library
;; files have elpi-builtin: URIs, and the definitions in accumulated files
;; are not found (they are copied in _build only, while the native locations
;; are in the source tree).

(copy_files ../browser.cjs)

(rule
 (alias default)
 (action (progn)))

(subdir node-js
 (copy_files ../../../../lsp/test/*.elpi)
 (rule
  (targets server.sh)
  (action
   (progn
    (with-stdout-to server.sh
     (echo "#!/bin/sh\nd=\"$(dirname \"$0\")\"\nexec node \"$d/../bridge.mjs\" node \"$d/../../../web_lsp_driver.bc.js\"\n"))
    (run chmod +x server.sh))))
 (rule
  (targets test_lsp.output accbad.output accmissing.output good.output syntax.output typeerr.output warn.output binders.output library.output macros.output libdef.output doc.output acctype.output lists.output accchar.output run.output assemble.output anomaly.output)
  (deps (glob_files *.elpi) server.sh ../bridge.mjs ../node-worker.cjs ../../../web_lsp_driver.bc.js)
  (action
   (with-stdout-to test_lsp.output (run %{exe:../../../../lsp/test/test_lsp.exe} ./server.sh .))))
 (rule
  (alias runtest-webrunner)
  (deps ../compare.cjs test_lsp.output accbad.output accmissing.output good.output syntax.output typeerr.output warn.output binders.output library.output macros.output libdef.output doc.output acctype.output lists.output accchar.output run.output assemble.output anomaly.output (glob_files ../*.expected) (glob_files ../../../../lsp/test/*.expected))
  (action (run node ../compare.cjs . .. ../../../../lsp/test))))

(subdir node-wasm
 (copy_files ../../../../lsp/test/*.elpi)
 (rule
  (targets server.sh)
  (action
   (progn
    (with-stdout-to server.sh
     (echo "#!/bin/sh\nd=\"$(dirname \"$0\")\"\nexec node \"$d/../bridge.mjs\" node \"$d/../../../web_lsp_driver.bc.wasm.js\"\n"))
