;; The tests of lsp/test (make tests-webrunner) on the web build of the
;; server, run by bridge.mjs, one directory each:
;;
;; - node-js, node-wasm: the server compiled to JavaScript, to WebAssembly, run
;;   as in Node (node-worker.cjs), where accumulate reads the files;
;; - browser-SCENARIO: the entry point elpi-lsp-web.js, run in an emulated
;;   browser (../browser.cjs) in SCENARIO, where it picks the server; what it
;;   loads (loaded.log) is compared with loaded-SCENARIO.expected. In a browser
;;   there are no files, accumulate fails: the scripts that accumulate files
;;   are not run.
;;
;; The outputs are compared (compare.cjs) with the ones of the native server,
;; but the ones that differ, whose expected outputs are here: the library
;; files have elpi-builtin: URIs, and the definitions in accumulated files
;; are not found (they are copied in _build only, while the native locations
;; are in the source tree).

(copy_files ../browser.cjs)

(rule
 (alias default)
 (action (progn)))

; the subdirs, one per way of running the server: generated by gen_dune.ml
; (edit it, then make tests-webrunner PROMOTE=true)
(include dune.inc)

(executable
 (name gen_dune)
 (modules gen_dune))

(rule
 (targets dune.inc.gen)
 (action (with-stdout-to %{targets} (run %{exe:gen_dune.exe}))))

(rule
 (alias runtest-webrunner)
 (action (diff dune.inc dune.inc.gen)))
