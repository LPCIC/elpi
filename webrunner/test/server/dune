  (deps (glob_files *.elpi) server.sh ../bridge.mjs ../node-worker.cjs ../../../web_lsp_driver.bc.wasm.js (glob_files ../../../web_lsp_driver.bc.wasm.assets/*.wasm))
  (action
   (with-stdout-to test_lsp.output (run %{exe:../../../../lsp/test/test_lsp.exe} ./server.sh .))))
 (rule
